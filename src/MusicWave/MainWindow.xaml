<Window x:Class="MusicWave.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:render="clr-namespace:MusicWave.Rendering" Title="MusicWave · 音乐律动桌面" Width="1320" Height="880" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="26,20,26,14">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border Width="38" Height="38" Background="#1C3A3E" CornerRadius="11" Margin="0,0,12,0"><TextBlock Text="≋" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
        <StackPanel><TextBlock Text="MusicWave" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="让桌面，跟着音乐呼吸。" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
        <Button Content="打开项目" Click="OpenProject_Click"/><Button Content="导出项目" Click="SaveProject_Click"/><Button Content="收起到托盘" Click="Hide_Click" Background="#192132"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#131A26" CornerRadius="12" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="01   节拍控制" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,18"/>
          <CheckBox Content="自动识别系统音乐 BPM" IsChecked="{Binding Automatic}"/>
          <TextBlock Text="通过扬声器回环监听，无需麦克风。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,14"/>
          <TextBlock Text="手动速度 / BPM" Foreground="{StaticResource Muted}"/>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBox Text="{Binding Bpm, StringFormat=F0}" FontSize="31" FontWeight="Light" Padding="10,4"/><Button Grid.Column="1" Content="点按定速" Click="Tap_Click" Margin="8,0,0,0" Padding="6" ToolTip="连续点按至少两次；切换为手动 BPM"/></Grid>
          <Slider Minimum="30" Maximum="240" Value="{Binding Bpm}" ToolTip="手动 BPM，自动模式下此值仅作手动备用"/>
          <TextBlock Text="自动模式下使用识别值；手动值保留。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,12"/>
          <DockPanel><TextBlock Text="节奏倍速" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Multiplier, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right"/></DockPanel>
          <Slider Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Multiplier}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="½" Tag="0.5" Click="Speed_Click" Padding="20,5"/><Button Content="1×" Tag="1" Click="Speed_Click" Padding="20,5"/><Button Content="2×" Tag="2" Click="Speed_Click" Padding="20,5"/></StackPanel>
          <TextBlock Text="音频输出设备" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="AudioDevices" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AudioDeviceId}" SelectionChanged="AudioDevice_Changed" Margin="0,0,0,12"/>
          <DockPanel><TextBlock Text="音频灵敏度" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Sensitivity, StringFormat=F1}" HorizontalAlignment="Right"/></DockPanel>
          <Slider Minimum="0.2" Maximum="4" Value="{Binding Sensitivity}"/>
          <Rectangle Height="1" Fill="#2A3345" Margin="0,12,0,18"/>
          <TextBlock Text="02   桌面图标" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
          <CheckBox Content="启用真实桌面图标起伏" IsChecked="{Binding AnimateIcons}"/>
          <DockPanel Margin="0,10,0,0"><TextBlock Text="上下幅度" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding IconAmplitude, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></DockPanel>
          <Slider Minimum="0" Maximum="160" Value="{Binding IconAmplitude}" ToolTip="以 1920 宽画布为基准，按每台显示器宽度缩放；4K 屏幕实际幅度为此值的 2 倍"/>
          <DockPanel><TextBlock Text="波浪错位" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding IconSpread, StringFormat=F2}" HorizontalAlignment="Right"/></DockPanel>
          <Slider Minimum="0" Maximum="2" Value="{Binding IconSpread}"/>
          <TextBlock Text="幅度按屏幕宽度缩放，预览采用真实图标布局。错位设为 0 时同步起伏。停止或退出时恢复原位。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19" Margin="0,7,0,0"/>
          <Button Content="恢复图标位置" Click="Restore_Click" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="78"/><RowDefinition Height="Auto"/><RowDefinition Height="178"/></Grid.RowDefinitions>
        <DockPanel Margin="2,0,0,12"><TextBlock Text="实时预览" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PREVIEW" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#2B3C50" BorderThickness="1" Background="#102033" ClipToBounds="True"><Viewbox Stretch="Uniform"><render:SceneRenderer x:Name="Preview" Width="960" Height="540" ShowPreviewIcons="True"/></Viewbox></Border>
        <Grid Grid.Row="2" Margin="4,12,4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LiveBpm" Text="120" FontSize="26" Foreground="{StaticResource Accent}" FontWeight="Light"/><TextBlock Text="有效 BPM" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ProgressBar x:Name="AudioMeter" Height="5" Minimum="0" Maximum="1" Foreground="#68E1CA" Background="#202B3D" BorderThickness="0"/><TextBlock x:Name="AudioState" Text="手动节拍 · 2.00 Hz" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="2" x:Name="PauseButton" Content="暂停" Click="Pause_Click" Padding="10,4" Margin="12,7,0,7"/></Grid>
        <DockPanel Grid.Row="3" Margin="0,10,0,10"><TextBlock Text="03   壁纸图层" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="静态背景" Click="Background_Click" Padding="10,6"/><Button Content="＋动态图层" Click="AddLayer_Click" Padding="10,6" Margin="0"/></StackPanel></DockPanel>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><ListBox x:Name="LayerList" ItemsSource="{Binding Layers}" SelectionChanged="Layer_Changed"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="◈" Foreground="{StaticResource Accent}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="静态" FontSize="10" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStatic}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="1" Margin="7,2,0,0"><Button Content="↑" Click="Up_Click" Padding="8,6" Margin="0,0,0,5" ToolTip="向后：更靠近背景"/><Button Content="↓" Click="Down_Click" Padding="8,6" Margin="0,0,0,5" ToolTip="向前：更靠近屏幕"/><Button Content="−" Click="Remove_Click" Padding="8,6" Margin="0,0,0,5" ToolTip="移除选中的项目图层"/></StackPanel></Grid>
      </Grid>
      <Border Grid.Column="4" Background="#131A26" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="图层属性" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
        <StackPanel x:Name="LayerEditor">
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,7"/>
          <StackPanel Orientation="Horizontal"><CheckBox Content="显示" IsChecked="{Binding Visible}" Margin="0,5,18,5"/><CheckBox Content="静止图层" IsChecked="{Binding IsStatic}"/></StackPanel>
          <Button Content="替换图片…" Click="Replace_Click" Margin="0,7,0,12"/>
          <TextBlock Text="位置与尺寸 / 屏幕百分比" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="中心 X %" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding X, StringFormat=F1}" Margin="0,4,0,8"/><TextBlock Text="宽度 %" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding Width, StringFormat=F1}" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="底部 Y %" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding Y, StringFormat=F1}" Margin="0,4,0,8"/><TextBlock Text="高度 %" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding Height, StringFormat=F1}" Margin="0,4,0,8"/></StackPanel></Grid>
          <DockPanel><TextBlock Text="不透明度" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Opacity, StringFormat=P0}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0" Maximum="1" Value="{Binding Opacity}"/>
          <Rectangle Height="1" Fill="#2A3345" Margin="0,8,0,14"/>
          <DockPanel><TextBlock Text="上下弹跳" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Bounce, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0" Maximum="180" Value="{Binding Bounce}"/>
          <DockPanel><TextBlock Text="压扁回弹" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Squash, StringFormat=P0}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0" Maximum="0.85" Value="{Binding Squash}"/>
          <DockPanel><TextBlock Text="左右摆动" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Sway, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0" Maximum="140" Value="{Binding Sway}"/>
          <DockPanel><TextBlock Text="节拍相位" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Phase, StringFormat={}{0:F0}°}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0" Maximum="360" Value="{Binding Phase}"/>
          <DockPanel><TextBlock Text="独立速度" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Speed, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right"/></DockPanel><Slider Minimum="0.25" Maximum="4" Value="{Binding Speed}" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
        </StackPanel>
        <TextBlock Text="透明 PNG 可让角色单独变形；静止图层始终保持原样。图层列表从后向前叠加。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" LineHeight="18" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,14,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Content="启用壁纸" IsChecked="{Binding AnimateWallpaper}" Margin="0,0,14,0"/><ComboBox x:Name="Monitors" Width="190" SelectedIndex="{Binding MonitorIndex}" SelectionChanged="Monitor_Changed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="停止并恢复" Click="Stop_Click" Padding="20,10"/><Button x:Name="ApplyButton" Content="▶  应用到桌面" Click="Apply_Click" Background="#68E1CA" Foreground="#0C2429" FontWeight="SemiBold" Padding="24,10" Margin="4,0,0,0"/></StackPanel></Grid>
    <DockPanel Grid.Row="3"><TextBlock x:Name="StatusText" Text="预览就绪 · 应用后开始控制桌面" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="Ctrl + Alt + P 暂停    /    Ctrl + Alt + R 恢复" Foreground="#69788E" FontSize="10" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
  </Grid>
</Window>
